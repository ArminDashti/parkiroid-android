<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/section_configure" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/username">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="yes"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="yes"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_url">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/apiUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/stream_url">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/streamUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/pingStatusTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/dogan_on_surface" />

        <TextView
            android:id="@+id/apiStatusTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/dogan_on_surface" />

        <TextView
            android:id="@+id/liveKitStatusTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/dogan_on_surface" />

        <TextView
            android:id="@+id/connectionErrorTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#EF9A9A"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectionBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disconnected_label" />

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_retention" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/log_retention_days">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/logRetentionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_browse" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logsBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logs_title"
            app:icon="@drawable/ic_logs" />

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushHistoryBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushLogsBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/flush_logs" />
    </LinearLayout>
</ScrollView>
