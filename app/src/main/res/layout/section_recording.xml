<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/section_configure" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/recordingEnabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recording_enabled" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/recordingSoundSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recording_audio_mode" />

        <include
            android:id="@+id/fpsStepper"
            layout="@layout/include_fps_stepper" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frame_quality">
            <AutoCompleteTextView
                android:id="@+id/recordingQualityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/recording_chunk_minutes">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recordingChunkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_retention" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/log_retention_days">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/logRetentionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_browse" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_button"
            app:icon="@drawable/ic_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyFramesBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/history_button"
            app:icon="@drawable/ic_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logsBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/logs_title"
            app:icon="@drawable/ic_logs" />

        <TextView
            style="@style/Widget.Dogan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushHistoryBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushLogsBtn"
            style="@style/Widget.Dogan.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/flush_logs" />
    </LinearLayout>
</ScrollView>
