<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_sync_interval">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/syncIntervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/active_camera">
            <AutoCompleteTextView
                android:id="@+id/cameraInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/keep_alive_interval">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/screenOnIntervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/log_retention_days">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/logRetentionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showBoundingBoxesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_bounding_boxes" />

        <TextView
            android:id="@+id/spotterUsageTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/dogan_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushSpotterBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_spotter" />

        <TextView
            android:id="@+id/watcherUsageTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dogan_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushWatcherBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_watchman" />

        <TextView
            android:id="@+id/copilotUsageTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dogan_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushCopilotBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_copilot" />

        <TextView
            android:id="@+id/logsUsageTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dogan_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flushLogsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flush_logs" />
    </LinearLayout>
</ScrollView>
